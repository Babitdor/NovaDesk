{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nova Desktop",
  "version": "0.10.1",
  "identifier": "app.novacode.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nova Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:*",
        "frame-src": "'self' http://127.0.0.1:*",
        "img-src": "'self' data:",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "worker-src": "'self'"
      },
      "capabilities": [
        "main-capability",
        "aux-capability"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/nova-tools"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMzc2NjVEOTc4NEEyQUYKUldTdm9vU1hYV1kzV3BNREtFeUVxU3c0UzlBS3hVSHdDcmtONXVlcE9acTBnY2ZqK3pFT3NKZEQK",
      "endpoints": [
        "https://github.com/Babitdor/NovaDesk/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
