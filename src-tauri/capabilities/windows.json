{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "aux-capability",
  "description": "Launcher and widget: events and their own window, no commands, no filesystem.",
  "webviews": [
    "launcher",
    "widget"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:path:default"
  ]
}
